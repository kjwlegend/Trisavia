# Documentation only: this file is not loaded automatically. Set environment variables in your shell.
M1_HOST=127.0.0.1
M1_PORT=8787
# Enable only behind a local reverse proxy that appends the actual client IP to X-Forwarded-For.
M1_TRUST_PROXY_LOOPBACK=0
M1_DATABASE_PATH=./data/m1.sqlite
# Optional on first startup; otherwise local identity metadata is generated with mode 0600.
# M1_INSTANCE_ID=your-local-instance
# M1_RECOVERY_EPOCH=your-current-recovery-epoch
# M1_IDENTITY_PATH=./data/m1.sqlite.identity.json

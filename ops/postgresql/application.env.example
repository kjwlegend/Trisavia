# Private deployment copy only: chmod 600; substitute paths, never commit values.
# Node 24: node --env-file=/absolute/private/application.env apps/platform/server.ts
M1_HOST=127.0.0.1
M1_PORT=8789
M1_TRUST_PROXY_LOOPBACK=0
M1_POSTGRES_CONNECTION_FILE=/absolute/private/application-database-url
M1_IDENTITY_PATH=/absolute/private/paired-identity.json
M1_EMAIL_MODE=experience
# Do not also set M1_DATABASE_URL, M1_DATABASE_PATH, or new identity/epoch values.
# Production real mail is a separate explicit configuration; no provider secrets here.

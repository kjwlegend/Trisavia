--- a/agents-era-trisavia.conf
+++ b/agents-era-trisavia.conf
@@ -1,3 +1,9 @@
+# Preserve validators only for this application's public static routes.
+map $uri $trisavia_static_if_none_match {
+    default "";
+    ~^/(world-map-(v2|life-v1)\.json$|assets/) $http_if_none_match;
+}
+
 server {
     listen 80;
     server_name trisavia.kjwlabs.com;
@@ -46,6 +52,21 @@
         add_header Cache-Control no-store always;
     }

+    location ~ ^/v1/agents/[^/]+/avatar-assets/drafts$ {
+        client_max_body_size 12m;
+        proxy_pass http://127.0.0.1:8790;
+        proxy_http_version 1.1;
+        proxy_set_header Host trisavia.kjwlabs.com;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $remote_addr;
+        proxy_set_header X-Forwarded-Proto https;
+        proxy_set_header Connection "";
+        proxy_connect_timeout 5s;
+        proxy_read_timeout 30s;
+        proxy_send_timeout 30s;
+        proxy_buffering off;
+    }
+
     location / {
         proxy_pass http://127.0.0.1:8790;
         proxy_http_version 1.1;
@@ -54,6 +75,7 @@
         proxy_set_header X-Forwarded-For $remote_addr;
         proxy_set_header X-Forwarded-Proto https;
         proxy_set_header Connection "";
+        proxy_set_header If-None-Match $trisavia_static_if_none_match;
         proxy_connect_timeout 5s;
         proxy_read_timeout 30s;
         proxy_send_timeout 30s;

{
  "name": "agents-era-m1-backend",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node apps/platform/server.ts",
    "dev": "node --watch apps/platform/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:e2e": "node scripts/run-e2e.ts",
    "build:web": "node scripts/build-web.mjs",
    "test:web-build": "node --test tests/build/web-build.test.mjs"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "jpeg-js": "0.4.4",
    "pg": "^8.23.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}

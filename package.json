{
  "name": "agents-era-m1-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node apps/platform/server.ts",
    "dev": "node --watch apps/platform/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
